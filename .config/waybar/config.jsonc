{
    "layer": "top",
    "position": "top",
    "height": 30,
    "margin-top": 5,
    "margin-left": 5,
    "margin-right": 5,
    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "mpris",
        "mpd"
    ],
    "modules-center": [
        "sway/window",
        "sway/scratchpad"
    ],
    "modules-right": [
        "tray",
        "group/sound",
        "custom/DDC10",
        "network",
        "battery",
        "keyboard-state",
        "clock",
        "group/info",
        "group/power"
    ],
    "custom/wf-recorder": {
        "format": "{text}",
        "exec": "echo 'Hola'",
        "signal": 1,
        "return-type": "json",
        "tooltip-format": "Stop recording"
    },
    "custom/DDC10": {
        "format": "{}",
        "exec": "~/.config/waybar/ddc-control.sh get",
        "return-type": "json",
        "signal": 1,
        "on-click": "~/.config/waybar/ddc-control.sh up",
        "on-click-right": "~/.config/waybar/ddc-control.sh down",
        "on-click-middle": "~/.config/waybar/ddc-control.sh toggle",
        "on-hover": "~/.config/waybar/ddc-control.sh get"
    },
    /**********************Terminados**********************/
    /* Sound Menu */
    "group/sound": {
        "orientation": "inherit",
        "modules": [
            "pulseaudio",
            "pulseaudio/slider"
        ],
        "drawer": {
            "transition-left-to-right": false,
            "children-class": "sound-drawer"
        },
        "on-scroll-up": "exec pamixer -i 1",
        "on-scroll-down": "exec pamixer -d 1"
    },
    "pulseaudio": {
        "on-click-right": "~/.config/waybar/toggle-apps.sh pavucontrol",
        "on-click": "exec pamixer -t",
        "format": "{volume} {icon}",
        "format-bluetooth": "{volume}% 󰂰",
        "format-bluetooth-muted": "{icon} 󰂲",
        "format-muted": " 󰝟 ",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰥰",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "󰄝",
            "car": "󰄋",
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        }
    },
    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },
    /* Power Menu */
    "group/power": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "children-class": "not-power",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/power",
            "custom/suspend",
            "custom/reboot",
            "custom/shutdown"
        ]
    },
    "custom/power": {
        "format": "󰤁",
        "tooltip": false
    },
    "custom/reboot": {
        "format": "󰜉",
        "tooltip": false,
        "on-click": "systemctl reboot"
    },
    "custom/suspend": {
        "format": "󰒲",
        "tooltip": false,
        "on-click": "swaylock && systemctl suspend"
    },
    "custom/shutdown": {
        "format": "",
        "tooltip": false,
        "on-click": "systemctl poweroff"
    },
    /* Tray */
    "tray": {
        "spacing": 5,
        "icon-size": 21
    },
    /* Sway  modules */
    "sway/workspaces": {
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "10": "0"
        },
        "persistent_workspaces": {
            "1": []
        }
    },
    "sway/scratchpad": {
        "format": "{icon}",
        "format-icons": [
            "",
            "",
            ""
        ],
        "tooltip-format": "{app}: {title}",
        "on-click": "swaymsg 'scratchpad show'",
        "on-click-right": "swaymsg 'move scratchpad'",
        "on-click-middle": "swaymsg '[floating] kill'"
    },
    "sway/window": {
        "format": "{}",
        "max-length": 30,
        "rewrite": {
            ".*[—-] ([^—-]+)$": "$1",
            "": "leoleguizamon"
        },
        "icon": true,
        "icon-size": 21,
        "on-click": "swaymsg 'move scratchpad'"
    },
    "sway/mode": {
        "format": "<span>{}</span>"
    },
    "sway/language": {
        "format": "{}",
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
    },
    /* Info Menu */
    "group/info": {
        "orientation": "inherit",
        "modules": [
            "user",
            "sway/language",
            "cpu",
            "memory",
            "temperature",
            "power-profiles-daemon"
        ],
        "drawer": {
            "transition-left-to-right": false,
            "children-class": "info-drawer"
        }
    },
    "cpu": {
        "format": "{usage}% 󰘚",
        "tooltip": true,
        "interval": 10
    },
    "memory": {
        "format": "{}% 󰍛",
        "interval": 10
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon}",
        "format-icons": [
            "󱃃",
            "󰔏",
            "󱃂"
        ]
    },
    "user": {
        "format": "",
        "interval": 9999,
        "height": 20,
        "width": 20,
        "icon": true,
        "open-on-click": true
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": " ",
            "performance": " ",
            "balanced": " ",
            "power-saver": " "
        }
    },
    /* Standar modules*/
    "clock": {
        "format": "{:%I:%M %p} 󰥔",
        "format-alt": "{:%d-%m-%Y} 󰃮",
        "tooltip-format": "<big>{:%d-%m-%Y}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click-right": "~/.config/waybar/toggle-apps.sh gnome-calendar",
        "calendar": {
            "format": {
                "today": "<span color='#39ff14'><b><u>{}</u></b></span>"
            }
        }
    },
    "network": {
        "format-wifi": "{essid} ({signalStrength}%) 󰖩",
        "format-ethernet": "{ifname} 󰈀",
        "format-linked": "{ifname} (No IP) 󰈀",
        "format-disconnected": "Disconnected 󰖪",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format": "{ifname}: {ipaddr}",
        "on-click-right": "~/.config/waybar/toggle-apps.sh nm-connection-editor"
    },
    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": {
            "numlock": "{icon}",
            "capslock": "{icon} "
        },
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },
    /* Battery modules*/
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰂄",
        "format-plugged": "{capacity}% 󰚥",
        "format-alt": "{time} {icon}",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ]
    },
    /* Power Menu */
    "group/light": {
        "orientation": "inherit",
        "modules": [
            "backlight",
            "backlight/slider"
        ],
        "drawer": {
            "transition-left-to-right": false,
            "children-class": "backlight-drawer"
        },
        "on-scroll-up": "brightnessctl set +1%",
        "on-scroll-down": "brightnessctl set 1%-"
    },
    "backlight": {
        "format": "{percent} {icon}",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ]
    },
    "backlight/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },
    "mpris": {
        // Formato principal
        "format": "{status_icon}  {title}",
        // Intervalo de actualización (opcional, en segundos)
        "interval": 1,
        // Configuración de tooltip
        "tooltip": true,
        "tooltip-format": "{title}\n{artist}\n{album}\n[{position}/{length}]\n\n{player_icon}  {player} - {status}",
        // Iconos por reproductor
        "player-icons": {
            "default": "",
            "spotify": "",
            "vlc": "󰕼",
            "firefox": "󰈹",
            "chrome": "",
            "chromium": "󰎆"
        },
        // Iconos por estado
        "status-icons": {
            "playing": "",
            "paused": "",
            "stopped": ""
        },
        // Tamaño máximo del texto (opcional)
        "title-len": 35
    }
}
